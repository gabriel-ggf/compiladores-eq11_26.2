// Teste: laco while simples, com condicao falsa de inicio e aninhado
int i = 0;
int soma = 0;
while (i < 5) {
    soma += i;
    i++;
}
printf("%d\n", soma);

// condicao falsa logo na entrada: corpo nunca executa
int j = 0;
while (j > 0) {
    printf("nunca\n");
}
printf("%d\n", j);

// while aninhado
int linha = 0;
int total = 0;
while (linha < 3) {
    int coluna = 0;
    while (coluna < 3) {
        total++;
        coluna++;
    }
    linha++;
}
printf("%d\n", total);
