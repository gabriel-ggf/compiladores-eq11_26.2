// Teste: break interrompe o laco e continue pula para a proxima iteracao
int i = 0;
while (1) {
    if (i == 3) {
        break;
    }
    printf("%d\n", i);
    i++;
}

// continue dentro de for: o incremento deve continuar rodando
int soma = 0;
for (int k = 0; k < 10; k++) {
    if (k % 2 == 0) {
        continue;
    }
    soma += k;
}
printf("%d\n", soma);
