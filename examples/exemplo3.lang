#include <stdio.h>

/* Exemplo: Estruturas de Repeticao e Controle de Fluxo */
int main(void) {

    printf("Numeros impares menores que 12 (pulando multiplos de 3):\n");
    for (int i = 1; i < 20; i++) {
        if (i > 11) {
            break;
        }
        if (i % 2 == 0 || i % 3 == 0) {
            continue;
        }
        printf("  -> %d\n", i);
    }

    int contador = 5;
    int soma = 0;
    while (contador > 0) {
        soma += contador;
        contador--;
    }
    printf("Soma de 5 ate 1 (while): %d\n", soma);

    int tentativas = 0;
    int potencia = 1;
    do {
        potencia *= 2;
        tentativas++;
    } while (potencia < 64);

    printf("Potencia de 2 atingida: %d em %d iteracoes\n", potencia, tentativas);

    return 0;
}